import express from "express";
import crypto from "crypto";
import fetch from "node-fetch";

const app = express();
app.use(express.json());

// === Config ===
const SOURCE_WEBHOOK_SECRET = "9e75564531091c83512f6bed2a447bf4c2a1df9f98d226d14e5daf988e20df9b"; 
const DEST_SHOPIFY_STORE = "n12et0-bw.myshopify.com"; 
const DEST_ACCESS_TOKEN = " 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"; 

// Verify webhook (Store A → Server)
function verifyShopifyWebhook(req) {
  const hmacHeader = req.get("X-Shopify-Hmac-SHA256");
  const body = JSON.stringify(req.body);
  const digest = crypto
    .createHmac("sha256", SOURCE_WEBHOOK_SECRET)
    .update(body, "utf8")
    .digest("base64");
  return digest === hmacHeader;
}

// Webhook endpoint - receive order from Store A
app.post("/webhook/orders", async (req, res) => {
  if (!verifyShopifyWebhook(req)) {
    return res.status(401).send("Unauthorized");
  }

  const order = req.body;

  try {
    // Prepare new order data for Store B
    const newOrder = {
      order: {
        line_items: order.line_items.map(item => ({
          title: item.title,
          quantity: item.quantity,
          price: item.price
        })),
        customer: {
          first_name: order.customer?.first_name,
          last_name: order.customer?.last_name,
          email: order.customer?.email,
        },
        shipping_address: order.shipping_address,
        billing_address: order.billing_address,
      }
    };

    // Send order to Store B
    const response = await fetch(https://${DEST_SHOPIFY_STORE}/admin/api/2025-01/orders.json, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-Shopify-Access-Token": DEST_ACCESS_TOKEN
      },
      body: JSON.stringify(newOrder)
    });

    const data = await response.json();
    console.log("✅ Order synced to Store B:", data);

    res.status(200).send("Order synced");
  } catch (err) {
    console.error("❌ Error syncing order:", err);
    res.status(500).send("Error");
  }
});

app.listen(3000, () => {
  console.log("🚀 Order Sync App running on port 3000");
});
